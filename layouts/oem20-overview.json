        "overview.network_configuration"
      ],
      "x": 0,
      "y": 0,
      "w": 4,
      "h": 3
    },
    {
      "id": "w_overview_system_configuration",
      "probeIds": [
        "overview.system_configuration"
      ],
      "x": 4,
      "y": 0,
      "w": 4,
      "h": 3
    },
    {
      "id": "w_overview_application_management",
      "probeIds": [
        "overview.application_management"
      ],
      "x": 8,
      "y": 0,
      "w": 4,
      "h": 3
    },
    {
      "id": "w_overview_package_configuration",
      "probeIds": [
        "overview.package_configuration"
      ],
      "x": 0,
      "y": 3,
      "w": 4,
      "h": 3
    },
    {
      "id": "w_overview_securityandrestriction",
      "probeIds": [
        "overview.securityandrestriction"
      ],
      "x": 4,
      "y": 3,
      "w": 4,
      "h": 3
    },
    {
      "id": "w_overview_data_capture_and_peripherals",
      "probeIds": [
        "overview.data_capture_and_peripherals"
      ],
      "x": 8,
      "y": 3,
      "w": 4,
      "h": 3
    },
    {
      "id": "w_overview_device_maintenance",
      "probeIds": [
        "overview.device_maintenance"
      ],
      "x": 0,
      "y": 6,
      "w": 4,
      "h": 3
    },
    {
      "id": "w_overview_profile_configuration",
      "probeIds": [
        "overview.profile_configuration"
      ],
      "x": 4,
      "y": 6,
      "w": 4,
      "h": 3
    }
  ]
}
