{
  "version": 1,
  "name": "OEM2.0 · 八大模块总览",
  "description": "一次看清 2.0 全部 L1 与框架条数；点布局切换进入各域 L2 目录",
  "grid": {
    "cols": 12,
    "rowHeight": 76,
    "margin": [
      10,
      10
    ],
    "compactType": "vertical"
  },
  "refresh": {
    "globalMs": 120000
  },
  "widgets": [
    {
      "id": "w_overview_network_configuration",
