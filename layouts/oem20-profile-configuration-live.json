{
  "version": 1,
  "name": "OEM2.0 · Profile Configuration · 设备实况",
  "oemModule": "Profile Configuration",
  "description": "ADB/Settings 直读（自动刷新）；框架完整目录见「框架目录」",
  "grid": {
    "cols": 12,
    "rowHeight": 72,
    "margin": [
      10,
      10
    ],
    "compactType": "vertical"
  },
  "refresh": {
    "globalMs": 15000,
    "pauseWhenHidden": true
  },
  "widgets": [
    {
      "id": "w_live_prof_boot",
      "probeIds": [
        "prof.boot"
      ],
      "x": 0,
      "y": 0,
      "w": 3,
      "h": 2
    },
    {
      "id": "w_live_prof_provisioned",
      "probeIds": [
        "prof.provisioned"
      ],
      "x": 3,
      "y": 0,
      "w": 3,
      "h": 2
    },
    {
      "id": "w_live_prof_setup_complete",
      "probeIds": [
        "prof.setup_complete"
      ],
      "x": 6,
      "y": 0,
      "w": 3,
      "h": 2
    },
    {
      "id": "w_live_prof_oem_unlock",
      "probeIds": [
        "prof.oem_unlock"
      ],
      "x": 9,
      "y": 0,
      "w": 3,
      "h": 2
    }
  ]
}
