      "y": 0,
      "w": 3,
      "h": 2
    },
    {
      "id": "w_sim_subs",
      "probeIds": ["sim.subscriptions"],
      "title": "Default SIM services",
      "oemPath": "Network Configuration › SIM Configuration",
