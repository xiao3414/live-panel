{
  "version": 1,
  "name": "OEM2.0 · Device Maintenance · 设备实况",
  "oemModule": "Device Maintenance",
  "description": "ADB/Settings 直读（自动刷新）；框架完整目录见「框架目录」",
  "grid": {
    "cols": 12,
    "rowHeight": 72,
    "margin": [
      10,
      10
    ],
    "compactType": "vertical"
  },
  "refresh": {
    "globalMs": 15000,
    "pauseWhenHidden": true
  },
  "widgets": [
    {
      "id": "w_live_maint_uptime",
      "probeIds": [
        "maint.uptime"
      ],
      "x": 0,
      "y": 0,
      "w": 3,
      "h": 2
    },
    {
      "id": "w_live_maint_boot",
      "probeIds": [
        "maint.boot"
      ],
      "x": 3,
      "y": 0,
      "w": 3,
      "h": 2
    },
    {
      "id": "w_live_maint_oem_log",
      "probeIds": [
        "maint.oem_log"
      ],
      "x": 6,
      "y": 0,
      "w": 3,
      "h": 2
    },
    {
      "id": "w_live_maint_battery_level",
      "probeIds": [
        "maint.battery_level"
      ],
      "x": 9,
      "y": 0,
      "w": 3,
      "h": 2
    },
    {
      "id": "w_live_maint_free_storage",
      "probeIds": [
        "maint.free_storage"
      ],
      "x": 0,
      "y": 2,
      "w": 3,
      "h": 2
    }
  ]
}
